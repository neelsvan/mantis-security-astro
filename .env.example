# Sanity (blog + case studies, fetched at build time)
PUBLIC_SANITY_PROJECT_ID=zxqjs2qh
PUBLIC_SANITY_DATASET=production

# Cloudflare Turnstile (contact form spam protection)
# Site key is public and baked into the pages at build time.
PUBLIC_TURNSTILE_SITE_KEY=

# These are only needed by the Pages Function at runtime — set them in the
# Cloudflare Pages dashboard (Settings → Environment variables), not in this file:
#   TURNSTILE_SECRET_KEY, RESEND_API_KEY, CONTACT_EMAIL_TO, CONTACT_EMAIL_FROM
