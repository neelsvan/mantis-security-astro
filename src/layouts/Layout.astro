---
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/roboto/300.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = 'https://mantissecurity.co.za';

const {
  title = 'Mantis Security | Integrated Security Solutions South Africa',
  description = 'Mantis Security delivers proactive, integrated security solutions combining 35+ years of expertise with advanced technology and elite personnel. Professional guarding, CCTV monitoring, risk assessments across South Africa.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="security company South Africa, integrated security solutions, professional security services, CCTV monitoring, security guarding services, Johannesburg security, PSIRA registered"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:site_name" content="Mantis Security" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', SITE_URL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-white text-mantis-black font-sans">
    <slot />
    <script>
      // Scroll-reveal: replaces framer-motion whileInView across the site.
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden (printing, crawlers, odd browsers) —
      // anything not yet revealed becomes visible shortly after load.
      setTimeout(() => {
        els.forEach((el) => {
          el.classList.add('is-visible');
          io.unobserve(el);
        });
      }, 2000);
    </script>
  </body>
</html>
