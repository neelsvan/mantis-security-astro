---
// Shared industry detail page template, ported from industry-page-template.tsx.
import { Shield, ArrowRight } from '@lucide/astro';
import * as Lucide from '@lucide/astro';
import CTASection from './CTASection.astro';
import type { Industry } from '../data/industries';

interface Props {
  industry: Industry;
}

const { industry } = Astro.props;
const { title, subtitle, heroImage, intro, challenges, solutions, relatedServices } = industry.template;

const getIcon = (name: string) => (Lucide as unknown as Record<string, any>)[name] ?? null;
---

<div>
  <!-- Hero -->
  <section class="relative py-32 md:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <img src={heroImage} alt={title} class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-mantis-black/95 via-mantis-black/80 to-mantis-black/40"></div>
    </div>
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{title}</h1>
        <p class="text-lg text-white/80">{subtitle}</p>
        <a
          href="/contact?type=assessment"
          class="mt-8 inline-flex items-center gap-2 bg-mantis-yellow hover:bg-mantis-yellow-dark text-mantis-black px-7 py-3.5 rounded-lg font-bold transition-all"
        >
          <Shield class="w-5 h-5" /> Request Industry-Specific Assessment
        </a>
      </div>
    </div>
  </section>

  <!-- Intro + Challenges -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-mantis-gray leading-relaxed mb-10">{intro}</p>
        <h2 class="text-2xl font-bold text-mantis-black mb-6">Common Security Challenges</h2>
        <div class="space-y-3 mb-10">
          {challenges.map((c) => (
            <div class="flex items-start gap-3 bg-red-50 rounded-lg p-4">
              <div class="w-2 h-2 rounded-full bg-mantis-red mt-2 shrink-0"></div>
              <span class="text-mantis-gray">{c}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section class="py-16 md:py-20 bg-mantis-light-gray">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-mantis-black mb-10 text-center">Our Solutions for Your Industry</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {solutions.map((s, i) => {
          const Icon = getIcon(s.icon);
          return (
            <div class="reveal bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all" style={`transition-delay: ${i * 80}ms`}>
              <div class="w-12 h-12 rounded-xl bg-mantis-yellow/10 flex items-center justify-center mb-4">
                {Icon && <Icon class="w-6 h-6 text-mantis-yellow" />}
              </div>
              <h3 class="font-bold text-mantis-black mb-2">{s.title}</h3>
              <p class="text-mantis-gray text-sm leading-relaxed">{s.desc}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-mantis-black mb-6 text-center">Related Services</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {relatedServices.map((s) => (
          <a
            href={s.href}
            class="bg-mantis-light-gray hover:bg-mantis-yellow/10 text-mantis-black px-6 py-3 rounded-lg font-medium transition-all flex items-center gap-2 hover:shadow-sm"
          >
            {s.name} <ArrowRight class="w-4 h-4" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection variant="red" />
</div>
