---
import { Shield, Phone } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
  variant?: 'dark' | 'red';
  buttonText?: string;
  buttonHref?: string;
}
const {
  title = 'Ready to Build a Smarter Security Strategy?',
  subtitle = 'Let our security experts assess your needs and design a tailored solution that protects what matters most.',
  variant = 'dark',
  buttonText = 'Request Security Assessment',
  buttonHref = '/contact?type=assessment',
} = Astro.props;

const bg = variant === 'red' ? 'bg-mantis-red' : 'bg-mantis-charcoal';
---

<section class={`${bg} py-16 md:py-24`}>
  <div class="reveal container-site text-center">
    <p class="eyebrow text-mantis-yellow mb-3">Get In Touch</p>
    <h2 class="text-3xl md:text-4xl lg:text-[2.75rem] font-bold leading-tight text-white mb-4">{title}</h2>
    <div class="w-16 h-1 bg-mantis-yellow mx-auto mb-6"></div>
    <p class="text-white/70 text-lg mb-10 max-w-2xl mx-auto">{subtitle}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={buttonHref} class="btn-primary text-lg">
        <Shield class="w-5 h-5" /> {buttonText}
      </a>
      <a href="tel:+27114871000" class="btn-outline-light">
        <Phone class="w-5 h-5" /> 011 487 1000
      </a>
    </div>
  </div>
</section>
