---
// Badge-style shield silhouette echoing the Mantis logo: scalloped crown, tapered point.
interface Props {
  class?: string;
}
const { class: className = 'w-6 h-6' } = Astro.props;
---

<svg viewBox="0 0 48 52" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} aria-hidden="true">
  <mask id="mantis-shield-mask">
    <path
      d="M24 2 L30 6 L38 4 L38 14 L44 18 L40 26 L44 34 L38 38 L38 46 L30 44 L24 50 L18 44 L10 46 L10 38 L4 34 L8 26 L4 18 L10 14 L10 4 L18 6 Z"
      fill="#fff"></path>
    <path
      d="M24 16 L25.6 20.6 L30.5 20.7 L26.6 23.6 L28 28.2 L24 25.4 L20 28.2 L21.4 23.6 L17.5 20.7 L22.4 20.6 Z"
      fill="#000"></path>
  </mask>
  <rect x="0" y="0" width="48" height="52" fill="currentColor" mask="url(#mantis-shield-mask)"></rect>
</svg>
