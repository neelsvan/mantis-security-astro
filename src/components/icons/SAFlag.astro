---
interface Props {
  class?: string;
}
const { class: className = 'w-6 h-4' } = Astro.props;
---

<svg
  viewBox="0 0 900 600"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label="South African flag"
>
  <rect width="900" height="600" fill="#DE3831"></rect>
  <polygon points="0,600 300,300 900,300 900,600" fill="#002395"></polygon>
  <path d="M0,0 L300,300 L900,300" fill="none" stroke="#FFFFFF" stroke-width="140" stroke-linejoin="round" stroke-linecap="butt"></path>
  <path d="M0,600 L300,300" fill="none" stroke="#FFFFFF" stroke-width="140" stroke-linejoin="round" stroke-linecap="butt"></path>
  <path d="M0,0 L300,300 L900,300" fill="none" stroke="#007A4D" stroke-width="84" stroke-linejoin="round" stroke-linecap="butt"></path>
  <path d="M0,600 L300,300" fill="none" stroke="#007A4D" stroke-width="84" stroke-linejoin="round" stroke-linecap="butt"></path>
  <polygon points="0,60 258,300 0,540" fill="#000000"></polygon>
</svg>
