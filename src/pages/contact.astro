---
import PublicLayout from '../layouts/PublicLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Phone, Mail, MapPin, Clock, Shield } from '@lucide/astro';

const contactInfo = [
  { icon: Phone, label: 'Phone', value: '011 487 1000', href: 'tel:+27114871000' },
  { icon: Mail, label: 'Email', value: 'info@mantissecurity.co.za', href: 'mailto:info@mantissecurity.co.za' },
  { icon: MapPin, label: 'Office', value: '2 Elm Street, Houghton Estate, Johannesburg, Gauteng', href: 'https://www.google.com/maps?q=2+Elm+Street,+Houghton+Estate,+Johannesburg' },
  { icon: Clock, label: 'Hours', value: '24/7 Control Room \u2022 Office: Mon\u2013Fri 07:00\u201317:00', href: '#' },
];
---

<PublicLayout
  title="Contact Us | Mantis Security"
  description="Get in touch with Mantis Security for a free security assessment. Call us at 011 487 1000 or visit our Houghton Estate offices."
>
  <!-- Hero -->
  <section class="relative pt-28 md:pt-36 pb-12 md:pb-16 bg-mantis-black overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 20% 50%, rgba(255,215,0,0.15) 0%, transparent 50%), radial-gradient(circle at 80% 50%, rgba(139,26,26,0.15) 0%, transparent 50%)"
      ></div>
    </div>
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6 text-center">
      <div>
        <div class="inline-flex items-center gap-2.5 bg-mantis-yellow/10 border border-mantis-yellow/30 rounded-full px-6 py-3 mb-6">
          <Shield class="w-5 h-5 text-mantis-yellow" />
          <span class="text-mantis-yellow text-base md:text-lg font-bold">Get Your Free Security Assessment</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Contact <span class="text-mantis-yellow">Mantis Security</span></h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">Ready to strengthen your security? Reach out for a free, no-obligation security assessment. Our expert team responds within 24 hours.</p>
      </div>
    </div>
  </section>

  <!-- Contact Info Cards -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 -mt-16">
        {contactInfo.map((item, i) => {
          const Icon = item.icon;
          return (
            <a
              href={item.href}
              class="reveal bg-white rounded-lg p-6 shadow-lg hover:shadow-xl transition-shadow text-center group"
              style={`transition-delay: ${i * 100}ms`}
            >
              <div class="w-14 h-14 rounded-full bg-mantis-red flex items-center justify-center mx-auto mb-4 group-hover:bg-mantis-red-dark transition-colors">
                <Icon class="w-6 h-6 text-mantis-yellow" />
              </div>
              <h3 class="font-semibold text-mantis-black mb-1">{item.label}</h3>
              <p class="text-gray-600 text-sm">{item.value}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Form + Map -->
  <section class="py-20 bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <SectionHeading title="Send Us a Message" subtitle="Fill in the form below and our team will get back to you within 24 hours." />
          <ContactForm />
        </div>
        <div>
          <SectionHeading title="Find Us" subtitle="Visit our offices at 2 Elm Street, Houghton Estate, Johannesburg." />
          <div class="rounded-lg overflow-hidden shadow-lg aspect-[4/3] bg-gray-200">
            <iframe
              src="https://www.google.com/maps?q=2+Elm+Street,+Houghton+Estate,+Johannesburg,+Gauteng&output=embed"
              width="100%"
              height="100%"
              style="border: 0"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mantis Security Office Location"
            ></iframe>
          </div>
          <div class="mt-8 p-6 bg-mantis-black/5 rounded-lg">
            <h3 class="font-bold text-lg mb-3 flex items-center gap-2"><Shield class="w-5 h-5 text-mantis-red" /> Emergency?</h3>
            <p class="text-gray-600 mb-4">For urgent security matters, call our 24/7 control room directly.</p>
            <a
              href="tel:+27861101000"
              class="inline-flex items-center gap-2 bg-mantis-red text-white px-6 py-3 rounded-lg font-semibold hover:bg-mantis-red/90 transition-colors"
            >
              <Phone class="w-5 h-5" /> Call Now: 0861 101 000
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
