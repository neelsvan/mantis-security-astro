---
import PublicLayout from '../layouts/PublicLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { Briefcase, MapPin, Clock, ArrowRight, Users, Award, TrendingUp } from '@lucide/astro';
import careersData from '../data/careers.json';

type Career = {
  title: string;
  department: string;
  location: string;
  type: string;
  description: string;
  requirements: string;
  isActive?: boolean;
  isSample?: boolean;
};

const careers = (careersData as Career[]).filter((c) => c.isActive !== false);

const benefits = [
  { icon: Award, title: 'PSIRA Training', desc: 'Full PSIRA-accredited training and ongoing skills development.' },
  { icon: Clock, title: '24/7 Operations', desc: 'Join a state-of-the-art control room running 365 days a year.' },
  { icon: TrendingUp, title: 'Career Growth', desc: 'Clear advancement pathways from officer to management.' },
  { icon: Users, title: 'Team Culture', desc: 'A blend of advanced technology and expertly trained personnel, 35+ years strong.' },
];
---

<PublicLayout
  title="Careers | Mantis Security"
  description="Join the Mantis Security team. Explore career opportunities in the security industry across South Africa."
>
  <section class="relative py-28 md:py-36 bg-mantis-black">
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6 text-center">
      <div>
        <div class="inline-flex items-center gap-2 bg-mantis-yellow/10 border border-mantis-yellow/20 rounded-full px-4 py-2 mb-6">
          <Briefcase class="w-4 h-4 text-mantis-yellow" />
          <span class="text-mantis-yellow text-sm font-medium">Join Our Team</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Careers at <span class="text-mantis-yellow">Mantis</span></h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">We&rsquo;re always on the lookout for talented individuals who are passionate about making a difference in the security industry. The right people are our greatest asset, and we welcome applicants at every career stage.</p>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <SectionHeading title="Why Work With Us" subtitle="Mantis Security invests in its people. Here's what you can expect." />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
        {benefits.map((b, i) => {
          const Icon = b.icon;
          return (
            <div class="reveal bg-gray-50 rounded-lg p-6 text-center hover:shadow-lg transition-shadow" style={`transition-delay: ${i * 100}ms`}>
              <div class="w-14 h-14 bg-mantis-yellow/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Icon class="w-6 h-6 text-mantis-yellow" />
              </div>
              <h3 class="font-bold text-mantis-black mb-2">{b.title}</h3>
              <p class="text-gray-600 text-sm">{b.desc}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Openings -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <SectionHeading title="Open Positions" subtitle="Explore current opportunities at Mantis Security." />
      {careers.some((c) => c.isSample) && (
        <div class="mt-8 bg-mantis-yellow/10 border border-mantis-yellow/30 rounded-lg p-5 text-sm text-mantis-black">
          <strong>Note for review:</strong> Postings marked &ldquo;Sample Content&rdquo; below are placeholders showing the intended format. Please send us your real, current openings (title, department, location, type, description, requirements) so we can replace them before launch.
        </div>
      )}
      <div class="mt-10 space-y-6">
        {careers.length === 0 ? (
          <div class="text-center py-16 bg-white rounded-lg shadow">
            <Briefcase class="w-16 h-16 text-gray-300 mx-auto mb-4" />
            <p class="text-gray-500 text-lg max-w-lg mx-auto">No positions currently available. We still encourage you to apply — your information will be kept on file for future opportunities.</p>
          </div>
        ) : (
          careers.map((c, i) => (
            <div class="reveal relative bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow" style={`transition-delay: ${i * 100}ms`}>
              {c.isSample && (
                <span class="absolute -top-3 left-6 bg-mantis-yellow text-mantis-black text-xs font-bold px-3 py-1 rounded-full shadow">Sample Content</span>
              )}
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                  <h3 class="text-xl font-bold text-mantis-black mb-2">{c.title}</h3>
                  <div class="flex flex-wrap gap-4 text-sm text-gray-500">
                    {c.department && <span class="flex items-center gap-1"><Briefcase class="w-4 h-4" />{c.department}</span>}
                    {c.location && <span class="flex items-center gap-1"><MapPin class="w-4 h-4" />{c.location}</span>}
                    {c.type && <span class="flex items-center gap-1"><Clock class="w-4 h-4" />{c.type}</span>}
                  </div>
                  <p class="text-gray-600 mt-3 text-sm line-clamp-2">{c.description}</p>
                </div>
                <a
                  href="/contact"
                  class="shrink-0 inline-flex items-center gap-2 bg-mantis-red text-white px-6 py-3 rounded-lg font-semibold hover:bg-mantis-red/90 transition-colors text-sm"
                >
                  Apply Now <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </section>

  <CTASection variant="dark" title="Don't See a Fit?" subtitle="Send us your CV anyway. We're always looking for talented security professionals." buttonText="Send Your CV" buttonHref="/contact" />
</PublicLayout>
